{
  "name": "Wiki.js 2.5 Wiki with Admin Preconfigured (Postgres)",
  "idSeed": "Wiki.js 2.5 Wiki with Admin Preconfigured (Postgres)",
  "description": "Markdown and visual wiki on Postgres; admin ready, setup wizard closed.",
  "category": "Other",
  "tags": [
    "wikijs",
    "wiki",
    "documentation",
    "knowledge-base",
    "markdown",
    "postgres",
    "self-hosted"
  ],
  "image": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/wikijs.svg",
  "upstream": {
    "repo": "requarks/wiki",
    "version": "2.5.315",
    "license": "AGPL-3.0",
    "images": {
      "wikijs": "requarks/wiki:2.5.315@sha256:af71a17dc27ccc4c768591b1c504631ed820d9d13d4e8c325be4232c0035638c (released 2026-09-21)",
      "postgres": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"
    },
    "checked": "2026-11-24"
  },
  "services": {
    "Wiki.js": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/wikijs.svg",
      "source": {
        "repo": "baranberkay96/wikijs-railway",
        "rootDirectory": "/services/wikijs"
      },
      "startCommand": null,
      "preDeployCommand": "node /wiki/railway/predeploy.js",
      "preDeployTimeoutSeconds": 1200,
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 600,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 3000,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "Port Wiki.js listens on.",
          "required": false
        },
        "DB_TYPE": {
          "defaultValue": "postgres",
          "description": "Database engine.",
          "required": false
        },
        "DB_HOST": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Postgres host on the private network.",
          "required": false
        },
        "DB_PORT": {
          "defaultValue": "5432",
          "description": "Postgres port.",
          "required": false
        },
        "DB_USER": {
          "defaultValue": "${{Postgres.POSTGRES_USER}}",
          "description": "Postgres user.",
          "required": false
        },
        "DB_PASS": {
          "defaultValue": "${{Postgres.POSTGRES_PASSWORD}}",
          "description": "Postgres password.",
          "required": false
        },
        "DB_NAME": {
          "defaultValue": "${{Postgres.POSTGRES_DB}}",
          "description": "Postgres database.",
          "required": false
        },
        "WIKI_SITE_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL stored on the first setup (later: Administration > General).",
          "required": false
        },
        "WIKI_ADMIN_EMAIL": {
          "defaultValue": "admin@example.com",
          "description": "Administrator login e-mail, created on the first deploy. Use your own address.",
          "required": false
        },
        "WIKI_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Administrator password (12+ characters), used on the first deploy only; change it later in your profile.",
          "required": false
        },
        "WIKI_GUEST_ACCESS": {
          "defaultValue": "false",
          "description": "true: keep Wiki.js' default public read access for guests. false: sign-in required (set on the first deploy).",
          "required": false
        },
        "LOG_LEVEL": {
          "defaultValue": "info",
          "description": "Log level (error, warn, info, verbose, debug).",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "30",
          "description": "Grace period for open requests on redeploy.",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": false
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": false
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": false
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": false
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "Private connection URL (Wiki.js uses the DB_* parts).",
          "required": false
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": false
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": false
        }
      }
    }
  }
}
